        <!-- SLIDE: HOJA DE RUTA (Outline) -->
        <!-- SLIDE 1.1: FUNDAMENTOS TEORICOS (1920-1944) -->
        <section class="slide">
            <h2 class="hero-title"
                style="font-size: 3rem; margin-bottom: 2rem; text-align: center; line-height: 1.2; background: linear-gradient(90deg, #fff, var(--c-green)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">
                <span
                    style="display: block; font-size: 0.4em; text-transform: uppercase; letter-spacing: 3px; color: var(--c-cyan); margin-bottom: 10px; font-weight: 400; -webkit-text-fill-color: initial;">1920
                    — 1944</span>
                Magnetismo 2D: Fundamentos Teóricos
            </h2>
            <div class="bento-grid"
                style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; max-width: 1400px; margin: 0 auto; height: 75vh; position: relative;">



                <!-- 1920: Lenz-Ising -->
                <div class="card-bento"
                    style="--c: var(--c-purple); grid-column: span 2; display: flex; flex-direction: column;">
                    <div class="module-number">1920</div>
                    <h3 style="font-size: 1.8rem; color: #fff; margin-top: 5px;">Modelo Lenz-Ising</h3>
                    <p style="color: var(--text-muted); font-size: 1.2rem; line-height: 1.4; flex: 1;">
                        Wilhelm Lenz propone un modelo simplificado de espines discretos ($\sigma_i = \pm 1$) para
                        explicar el ferromagnetismo.
                    </p>
                    <div
                        style="font-family:'JetBrains Mono'; color: var(--c); font-size: 1.4rem; text-align: center; margin-top: 10px;">
                        $$ H = -J \sum \sigma_i \sigma_j $$
                    </div>
                </div>

                <!-- 1925: Ising 1D -->
                <div class="card-bento"
                    style="--c: var(--c-stone); grid-column: span 2; display: flex; flex-direction: column;">
                    <div class="module-number">1925</div>
                    <h3 style="font-size: 1.8rem; color: #fff; margin-top: 5px;">Solución 1D (Ising)</h3>
                    <p style="color: var(--text-muted); font-size: 1.2rem; line-height: 1.4; flex: 1;">
                        Ernst Ising resuelve el modelo en 1D y demuestra que <strong>NO hay transición de fase</strong>.
                    </p>
                    <div
                        style="background: rgba(255,255,255,0.05); padding: 8px; border-radius: 6px; text-align: center; color: #94a3b8; font-size: 1.1rem;">
                        <i class="fas fa-times-circle" style="color: var(--c-ind);"></i> Conclusión errónea para 2D
                    </div>
                </div>

                <!-- 1928: Heisenberg -->
                <div class="card-bento"
                    style="--c: var(--c-blue); grid-column: span 2; display: flex; flex-direction: column;">
                    <div class="module-number">1928</div>
                    <h3 style="font-size: 1.8rem; color: #fff; margin-top: 5px;">Modelo Heisenberg</h3>
                    <p style="color: var(--text-muted); font-size: 1.2rem; line-height: 1.4; flex: 1;">
                        Werner Heisenberg introduce el modelo cuántico con espines vectoriales ($\mathbf{S}_i$) y
                        simetría rotacional continua.
                    </p>
                    <div style="font-family:'JetBrains Mono'; color: var(--c); font-size: 1.4rem; text-align: center;">
                        $$ \hat{H} = -J \mathbf{S}_i \cdot \mathbf{S}_j $$
                    </div>
                </div>

                <!-- 1936: Peierls Argument (Span 2) -->
                <div class="card-bento"
                    style="--c: var(--c-green); grid-column: span 2; display: flex; flex-direction: column;">
                    <div class="module-number">1936</div>
                    <h3 style="font-size: 1.8rem; color: #fff; margin-top: 5px;">Argumento de Peierls</h3>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.4; flex: 1;">
                        Rudolf Peierls demuestra geométricamente (paredes de dominio) que el modelo de Ising 2D
                        <strong>SÍ</strong> puede tener una transición de fase.
                    </p>
                    <div
                        style="display: flex; gap: 10px; align-items: center; justify-content: center; margin-top: 10px;">
                        <span class="badge"
                            style="background: rgba(74, 222, 128, 0.1); color: var(--c-green); border: 1px solid var(--c-green); font-size: 0.9rem;">Hito
                            Teórico</span>
                    </div>
                </div>

                <!-- 1941: Kramers-Wannier (Span 2) -->
                <div class="card-bento"
                    style="--c: var(--c-poly); grid-column: span 2; display: flex; flex-direction: column;">
                    <div class="module-number">1941</div>
                    <h3 style="font-size: 1.8rem; color: #fff; margin-top: 5px;">Dualidad Kramers-Wannier</h3>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.4; flex: 1;">
                        Relaciones de dualidad que permitieron <strong>localizar exactamente</strong> la temperatura
                        crítica sin resolver todo el modelo.
                    </p>
                    <div
                        style="background: rgba(217, 70, 239, 0.1); padding: 8px; border-radius: 6px; text-align: center; color: var(--c-poly); font-size: 0.95rem; font-weight: 700;">
                        Impacto: $T_c$ exacta
                    </div>
                </div>

                <!-- 1944: Onsager Solution (Span 2 - Hero) -->
                <div class="card-bento"
                    style="--c: var(--c-danger); grid-column: span 2; display: flex; flex-direction: column; background: linear-gradient(145deg, rgba(239, 68, 68, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(239, 68, 68, 0.4); box-shadow: 0 10px 30px rgba(239, 68, 68, 0.1);">
                    <div class="module-number">1944</div>
                    <h3 style="font-size: 1.8rem; color: #fff; margin-top: 5px;">Solución Exacta de Onsager</h3>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.4; flex: 1;">
                        Onsager resuelve el modelo Ising 2D en campo cero. La prueba definitiva de transiciones de fase.
                        <strong>24 años de desarrollo teórico.</strong>
                    </p>
                    <div
                        style="font-family:'JetBrains Mono'; color: var(--c); font-size: 1.2rem; text-align: center; text-shadow: 0 0 15px rgba(239, 68, 68, 0.3);">
                        $$ T_c \approx 2.269 J/k_B $$
                    </div>
                </div>

            </div>
        </section>

        <!-- SLIDE 1.2: TEOREMAS Y EVIDENCIA (1966-1973) -->
        <section class="slide">
            <h2 class="hero-title"
                style="font-size: 3rem; margin-bottom: 2rem; text-align: center; line-height: 1.2; background: linear-gradient(90deg, #fff, var(--c-green)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">
                <span
                    style="display: block; font-size: 0.4em; text-transform: uppercase; letter-spacing: 3px; color: var(--c-cyan); margin-bottom: 10px; font-weight: 400; -webkit-text-fill-color: initial;">1966
                    — 1973</span>
                Teoremas y Evidencia Experimental
            </h2>
            <div class="bento-grid"
                style="display: grid; grid-template-columns: repeat(6, 1fr); grid-template-rows: 45% 55%; gap: 20px; max-width: 1400px; margin: 0 auto; height: 75vh; position: relative;">



                <!-- 1966: Mermin-Wagner -->
                <div class="card-bento"
                    style="--c: var(--c-ind); grid-column: span 3; display: flex; flex-direction: column;">
                    <div class="module-number">1966</div>
                    <h3 style="font-size: 2rem; color: #fff; margin-top: 5px;">Teorema Mermin-Wagner</h3>
                    <p style="color: var(--text-muted); font-size: 1.3rem; line-height: 1.6; flex: 1;">
                        Prohibe rigurosamente el orden magnético de largo alcance (LRO) en 2D a $T > 0$ para sistemas
                        con <strong>simetría continua</strong> (modelo Heisenberg isótropo).
                    </p>
                    <div
                        style="background: rgba(239, 68, 68, 0.1); padding: 15px; border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 1.1rem;">
                        <strong style="color: var(--c-ind);">Consecuencia:</strong> Se requiere anisotropía (MAE) para
                        estabilizar el magnetismo 2D.
                    </div>
                </div>

                <!-- 1966: Gradmann (Experimental) -->
                <div class="card-bento"
                    style="--c: var(--c-gold); grid-column: span 3; display: flex; flex-direction: column;">
                    <div class="module-number" style="right: auto; left: 20px;">EXP</div>
                    <h3 style="font-size: 2rem; color: #fff; margin-top: 5px; text-align: right;">Evidencia: Ni(111) /
                        Cu(111)</h3>
                    <p
                        style="color: var(--text-muted); font-size: 1.3rem; line-height: 1.6; flex: 1; text-align: right;">
                        Ulrich Gradmann demuestra ferromagnetismo en películas de Níquel de solo <strong>3 capas
                            atómicas</strong> (7 Å).
                    </p>
                    <div
                        style="display: flex; justify-content: flex-end; align-items: center; gap: 15px; margin-top: 10px;">
                        <span style="font-size: 3rem; color: var(--c-gold);"><i class="fas fa-microscope"></i></span>
                        <div style="text-align: right;">
                            <div style="color: #fff; font-weight: 700; font-size: 1.2rem;">Primer Magnetismo 2D</div>
                            <div style="color: var(--c-gold); font-size: 1rem;">Validación Experimental</div>
                        </div>
                    </div>
                </div>

                <!-- 1973: BKT -->
                <!-- 1973: BKT -->
                <div class="card-bento"
                    style="--c: var(--c-quantum); grid-column: span 6; display: flex; flex-direction: column; position: relative; padding: 30px; background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(15, 23, 42, 0.9)); border: 1px solid rgba(167, 139, 250, 0.4); box-shadow: 0 10px 40px rgba(167, 139, 250, 0.15);">

                    <div class="module-number"
                        style="position: absolute; top: 20px; right: 25px; opacity: 0.5; font-size: 3.5rem; color: rgba(255,255,255,0.1);">
                        1973</div>

                    <h3 style="font-size: 2.2rem; color: #fff; margin-top: 5px; margin-bottom: 5px;">Transición BKT
                    </h3>

                    <h4
                        style="font-size: 1.3rem; color: var(--c-quantum); font-weight: 400; font-family: 'JetBrains Mono'; margin-bottom: 20px;">
                        Berezinskii–Kosterlitz–Thouless
                    </h4>

                    <p style="color: var(--text-muted); font-size: 1.4rem; line-height: 1.5; margin-bottom: 0;">
                        <strong style="color: var(--c-quantum);">Premio Nobel 2016.</strong> Introduce el <strong>Orden
                            Topológico</strong>.
                        <br><br>
                        La transición ocurre por la disociación ("unbinding") de pares vórtice-antivórtice. Permite una
                        fase de bajo desorden con <strong>correlaciones algebraicas</strong> (Cuasi-Largo Alcance),
                        evadiendo la prohibición de Mermin-Wagner.
                    </p>
                </div>

            </div>
        </section>

