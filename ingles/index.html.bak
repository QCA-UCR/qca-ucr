                                style="color: var(--c-ind); margin-right: 10px;"></i>Ref: <em>Nature 546, 270
                                (2017)</em>.</li>
                        <li><i class="fas fa-thermometer-half"
                                style="color: var(--c-ind); margin-right: 10px;"></i>Temperatura Crítica: <strong>~45
                                K</strong>.</li>
                    </ul>
                </div>

                <!-- Card 2: Cr2Ge2Te6 (Right) -->
                <div class="card-bento"
                    style="--c: var(--c-blue); display: flex; flex-direction: column; background: linear-gradient(135deg, rgba(56, 189, 248, 0.05), rgba(15, 23, 42, 0.6)); border-color: rgba(56, 189, 248, 0.3);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
