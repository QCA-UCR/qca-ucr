<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Presentación J. Ignacio Borge</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">

    <style>
        /* =========================================
           ESTILOS GENERALES (Importados de i.html)
           ========================================= */
        :root {
            --bg-deep: #09090b;
            --bg-gradient:
                radial-gradient(circle at 15% 50%, rgba(34, 211, 238, 0.08), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(192, 132, 252, 0.08), transparent 25%);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --c-cyan: #22d3ee;
            --accent-cyan: #22d3ee;
            --accent-purple: #a78bfa;
            --accent-gold: #fde047;

            --glass-bg: rgba(30, 41, 59, 0.4);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-blur: blur(24px);

            /* Colores Temáticos */
            --c-stone: #a8a29e;
            --c-bronze: #f59e0b;
            --c-iron: #60a5fa;
            --c-ind: #ef4444;
            --c-poly: #d946ef;
            --c-silicon: #10b981;
            --c-quantum: #a78bfa;

            --c-blue: #38bdf8;
            --c-purple: #a78bfa;
            --c-pink: #f472b6;
            --c-gold: #facc15;
            --c-danger: #ef4444;
            --c-green: #4ade80;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-deep);
            background-image: var(--bg-gradient);
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            height: 100vh;
            overflow: hidden;
        }

        body::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: -1;
        }

        /* SLIDES */
        #slides-container {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            transform: scale(0.98);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
            padding: 40px;
        }

        .slide.active {
            opacity: 1;
            visibility: visible;
            pointer-events: all;
            transform: scale(1);
            z-index: 10;
        }

        /* Indicador */
        .slide-indicator {
            position: fixed;
            bottom: 40px;
            right: 50px;
            font-family: 'Inter', sans-serif;
            font-variant-numeric: tabular-nums;
            color: var(--text-muted);
            opacity: 0.5;
            font-size: 0.9rem;
            z-index: 100;
            transition: opacity 0.5s;
        }

        .slide-indicator.hidden {
            opacity: 0;
        }

        /* UTILIDADES VISUALES */
        .slide-content {
            width: 100%;
            max-width: 1400px;
            height: 90%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        .hero-title {
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 4.4rem;
            line-height: 1.05;
            background: linear-gradient(135deg, #ffffff 30%, #94a3b8 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .hero-highlight {
            background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-subtitle {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 2.2rem;
            color: var(--text-muted);
            font-weight: 400;
            margin-bottom: 4rem;
            text-align: center;
        }

        .premium-badge {
            display: inline-flex;
            align-items: center;
            gap: 15px;
            padding: 12px 30px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 100px;
            font-size: 1.35rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--accent-gold);
            margin-bottom: 2rem;
            backdrop-filter: blur(10px);
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .glass-card:hover {
            transform: translateY(-8px) scale(1.005);
            box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.6), 0 0 25px rgba(255, 255, 255, 0.15) inset;
            border-color: rgba(255, 255, 255, 0.5);
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 100%);
        }

        .deco-line {
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            margin: 2rem 0;
        }

        .text-center {
            text-align: center;
        }

        .meta-info {
            display: flex;
            justify-content: center;
            gap: 60px;
            margin-top: 3rem;
            font-family: 'Inter', sans-serif;
            text-align: left;
        }

        .meta-block h4 {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .meta-block p {
            font-size: 1.1rem;
            color: var(--text-main);
            font-weight: 500;
            margin: 0;
        }

        /* INTRO CAPITULOS (REACTOR) */
        .reactor-container {
            position: relative;
            width: 180px;
            height: 180px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 3rem;
        }

        .reactor-ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid transparent;
            border-top-color: var(--c-blue);
            border-right-color: var(--c-purple);
            animation: spin 4s linear infinite;
            box-shadow: 0 0 50px rgba(56, 189, 248, 0.3);
        }

        .reactor-ring::before {
            content: "";
            position: absolute;
            inset: 15px;
            border-radius: 50%;
            border: 2px solid transparent;
            border-bottom-color: var(--c-purple);
            border-left-color: var(--c-blue);
            animation: spin 3s linear infinite reverse;
        }

        .reactor-core {
            position: absolute;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: inset 0 0 30px rgba(167, 139, 250, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .reactor-text {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            font-weight: 400;
            /* Regular font weight for better readability */
            color: #fff;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.8);
            /* letter-spacing: -3px; Removed strict letter-spacing */
        }

        @keyframes spin {
            100% {
                transform: rotate(360deg);
            }
        }

        @keyframes pulse-glow {
            0% {
                box-shadow: 0 0 15px 2px rgba(34, 211, 238, 0.3);
                border-color: rgba(34, 211, 238, 0.4);
            }

            100% {
                box-shadow: 0 0 35px 8px rgba(34, 211, 238, 0.6);
                border-color: rgba(34, 211, 238, 0.9);
            }
        }

        @keyframes pulse-glow-purple {
            0% {
                box-shadow: 0 0 15px 2px rgba(167, 139, 250, 0.3);
                border-color: rgba(167, 139, 250, 0.4);
            }

            100% {
                box-shadow: 0 0 35px 8px rgba(167, 139, 250, 0.6);
                border-color: rgba(167, 139, 250, 0.9);
            }
        }

        /* CARD BENTO / MODULES */
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            width: 100%;
            height: 100%;
        }

        .card-bento {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease, background 0.3s ease;
            cursor: pointer;
        }

        .card-bento::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--c);
            opacity: 0.7;
            transition: all 0.3s ease;
        }

        .card-bento:hover {
            background: rgba(30, 41, 59, 0.9);
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-5px);
            z-index: 5;
            box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.6);
        }

        .card-bento:hover::after {
            opacity: 1;
            box-shadow: 0 0 20px 2px var(--c);
        }

        .module-number {
            font-size: 4rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.05);
            position: absolute;
            top: -10px;
            right: 0px;
            font-family: 'JetBrains Mono';
        }

        /* MODAL */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(15px);
            z-index: 2000;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: 0.4s;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .modal-content {
            width: 90%;
            max-width: 1200px;
            height: auto;
            max-height: 90vh;
            background: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transform: scale(0.95) translateY(20px);
            transition: 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        }

        .modal-overlay.active .modal-content {
            transform: scale(1) translateY(0);
        }

        .modal-bar {
            height: 4px;
            width: 100%;
            background: var(--mc);
            box-shadow: 0 0 30px var(--mc);
        }

        .modal-body {
            padding: 40px;
            overflow-y: auto;
            text-align: left;
            display: flex;
            gap: 40px;
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            border: none;
            color: #fff;
            font-size: 1.2rem;
            cursor: pointer;
            z-index: 10;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: 0.3s;
        }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--mc);
            transform: rotate(90deg);
            box-shadow: 0 0 15px var(--mc);
        }

        .script-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            line-height: 1.8;
            color: #e2e8f0;
            border-left: 3px solid rgba(255, 255, 255, 0.1);
            padding-left: 30px;
        }

        /* --- DASHBOARD & TABLE STYLES --- */
        .dashboard-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
            width: 90%;
            /* Reduced from 100% to create outer margin */
            max-width: 1200px;
            /* Reduced max-width for tighter feel */
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 85vh;
            margin: 0 auto;
            backdrop-filter: blur(10px);
        }

        .header-t3 {
            padding: 25px 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(15, 23, 42, 0.5);
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .title-t3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff;
            margin: 0;
        }

        .subtitle-t3 {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.5;
            text-align: right;
        }

        .table-container {
            overflow-y: auto;
            flex: 1;
        }

        table.t3-table {
            width: 100%;
            /* Reset to fill the smaller container */
            border-collapse: collapse;
            font-size: 15px;
        }

        table.t3-table th {
            background-color: rgba(15, 23, 42, 0.8);
            color: #94a3b8;
            padding: 18px 10px;
            /* Reduced side padding for centered text */
            text-align: center;
            /* CENTER ALIGNMENT */
            cursor: pointer;
            position: sticky;
            top: 0;
            z-index: 2;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            text-transform: none;
            /* REMOVED UPPERCASE */
            font-size: 0.9rem;
            /* Slightly larger since not uppercase */
            letter-spacing: 0.5px;
            /* Reduced spacing */
            transition: background 0.3s;
            vertical-align: middle;
            /* ALIGN TO MIDDLE */
        }

        /* COLUMN WIDTH DISTRIBUTION */
        table.t3-table th:nth-child(1) {
            width: 8%;
        }

        /* Elemento */
        table.t3-table th:nth-child(2) {
            width: 9%;
        }

        /* Config */
        table.t3-table th:nth-child(3) {
            width: 8%;
        }

        /* nval */
        table.t3-table th:nth-child(4) {
            width: 8%;
        }

        /* Delta E */
        table.t3-table th:nth-child(5) {
            width: 20%;
        }

        /* Momento (Balanced) */
        table.t3-table th:nth-child(6) {
            width: 15%;
        }

        /* Temp */
        table.t3-table th:nth-child(7) {
            width: 12%;
        }

        /* Estado */
        table.t3-table th:nth-child(8) {
            width: 20%;
        }

        /* Conductividad */

        table.t3-table th:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #fff;
        }

        table.t3-table td {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
            text-align: center;
            /* CENTER ALIGNMENT */
            color: var(--text-muted);
        }

        table.t3-table tr:hover td {
            background-color: rgba(255, 255, 255, 0.03);
            color: #fff;
        }

        .col-element {
            font-weight: 700;
            color: #fff !important;
            font-size: 1.1rem;
            width: 60px;
        }

        .col-config {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
            color: var(--c-purple) !important;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            min-width: 80px;
            justify-content: center;
            white-space: nowrap;
        }

        .badge.fm {
            background: rgba(34, 211, 238, 0.1);
            color: var(--c-cyan);
            border: 1px solid rgba(34, 211, 238, 0.3);
        }

        .badge.afm {
            background: rgba(251, 191, 36, 0.1);
            color: var(--c-gold);
            border: 1px solid rgba(251, 191, 36, 0.3);
        }

        .badge.nm {
            background: rgba(148, 163, 184, 0.1);
            color: #94a3b8;
            border: 1px solid rgba(148, 163, 184, 0.3);
        }

        .bar-container {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
            color: #fff;
        }

        .bar-bg {
            flex-grow: 1;
            height: 6px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            overflow: hidden;
            width: 100px;
            max-width: 120px;
        }

        .bar-fill {
            height: 100%;
            border-radius: 3px;
        }

        .footer-t3 {
            padding: 20px 30px;
            font-size: 0.9rem;
            color: #64748b;
            background: rgba(15, 23, 42, 0.3);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            text-align: left;
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>
</head>

<body>

    <div class="slide-indicator hidden" id="slide-indicator">
        <span id="current-slide">1</span> <span style="margin:0 5px; opacity:0.3">/</span> <span
            id="total-slides">0</span>
    </div>


    <div id="slides-container">

        <!-- SLIDE 1: PORTADA -->
        <section class="slide active">
            <div class="slide-content text-center"
                style="display: flex; flex-direction: column; justify-content: space-between; height: 100%; padding: 60px 0 40px 0; box-sizing: border-box;">

                <!-- 1. Top: Badge (Flex Item) -->
                <div style="flex: 0 0 auto; margin-top: 0;">
                    <div class="premium-badge"><i class="fa-solid fa-atom"></i> Investigación Postdoctoral</div>
                </div>

                <!-- 2. Middle: Title Block (Flex Item - Centered in remaining space) -->
                <div style="flex: 1; display: flex; flex-direction: column; justify-content: center;">
                    <h1 class="hero-title"
                        style="font-size: 4rem; font-weight: 700; line-height: 1.1; margin-bottom: 20px; letter-spacing: -1px; margin-top: 0;">
                        <span
                            style="background: linear-gradient(90deg, #fff, var(--c-cyan)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">Ingeniería
                            de Espín</span>
                        <span
                            style="font-weight: 300; font-size: 3rem; display: block; margin-top: 10px; color: #cbd5e1;">en
                            materiales 2D <span
                                style="font-family: 'Inter', sans-serif; font-weight: 400; color:var(--c-cyan);">(Nb<sub>0.8</sub>Ti<sub>0.2</sub>)<sub>4</sub>C<sub>3</sub>T<sub>x</sub></span>
                            (MXenes)</span>
                    </h1>
                    <h2 class="hero-subtitle"
                        style="font-size: 1.8rem; font-weight: 300; margin-top: 30px; max-width: 900px; margin-left: auto; margin-right: auto; line-height: 1.5; color: #94a3b8;">
                        Un Enfoque Teórico desde el <strong style="color: var(--c-cyan); font-weight: 600;">Magnetismo
                            Funcional</strong> hacia posibles usos en <strong
                            style="background: linear-gradient(90deg, var(--c-pink), var(--c-purple)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; font-weight: 700;">Computación
                            Cuántica</strong>
                    </h2>
                    <div class="deco-line" style="max-width: 200px; margin: 3rem auto;"></div>
                </div>

                <!-- 3. Bottom: Footer (Flex Item) -->
                <div class="meta-info"
                    style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; text-align: left; max-width: 1400px; width: 95%; margin: 0 auto; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.1);">

                    <!-- Researcher -->
                    <div class="meta-block"
                        style="display: flex; gap: 15px; align-items: flex-start; justify-self: start;">
                        <div
                            style="background: rgba(6,182,212,0.1); padding: 10px; border-radius: 8px; color: var(--c-cyan);">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                        <div>
                            <h4
                                style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; color: #64748b; margin-bottom: 5px;">
                                Investigador</h4>
                            <p style="font-size: 1.2rem; color: #fff; font-weight: 500;">J. Ignacio Borge</p>
                            <p
                                style="font-size: 0.85rem; color: var(--c-cyan); font-weight: 300; margin-top: 2px; font-style: italic;">
                                Científico computacional de materiales</p>
                        </div>
                    </div>

                    <!-- Date -->
                    <div class="meta-block"
                        style="display: flex; gap: 15px; align-items: flex-start; justify-self: center;">
                        <div
                            style="background: rgba(236,72,153,0.1); padding: 10px; border-radius: 8px; color: var(--c-pink);">
                            <i class="fa-regular fa-calendar-check"></i>
                        </div>
                        <div>
                            <h4
                                style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; color: #64748b; margin-bottom: 5px;">
                                Fecha</h4>
                            <p style="font-size: 1.2rem; color: #fff; font-weight: 500;">Viernes, 16 de Enero</p>
                            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 2px;">2026</p>
                        </div>
                    </div>

                    <!-- Institution -->
                    <div class="meta-block"
