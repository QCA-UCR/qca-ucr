                <div
                    style="flex: 1; display: flex; align-items: center; justify-content: center; font-family:'JetBrains Mono'; color: var(--c); font-size: 1.35rem; text-shadow: 0 0 10px rgba(0,0,0,0.5);">
                    $$ I \cdot N(E_F) > 1 $$
                </div>
            </div>
            <!-- 2. Exchange (Span 2 cols) -->
            <div class="card-bento"
                style="--c: var(--c-gold); grid-column: span 2; display: flex; flex-direction: column;"
                onclick="openModal('param2')">
                <div class="module-number">02</div>
                <h3 style="font-size: 1.6rem; color: #fff; margin-top: 15px;">Intercambio ($J$ coupling)</h3>
                <div
                    style="flex: 1; display: flex; align-items: center; justify-content: center; font-family:'JetBrains Mono'; color: var(--c); font-size: 1.35rem; text-shadow: 0 0 10px rgba(0,0,0,0.5);">
                    $$ \mathcal{H} = -\sum_{i,j} J_{ij} \mathbf{S}_i \cdot \mathbf{S}_j $$
                </div>
            </div>
            <!-- 3. MAE (Span 2 cols) -->
            <div class="card-bento"
                style="--c: var(--c-blue); grid-column: span 2; display: flex; flex-direction: column;"
                onclick="openModal('param3')">
                <div class="module-number">03</div>
                <h3 style="font-size: 1.6rem; color: #fff; margin-top: 15px; text-align: center;">Magnetocrystalline
                    Anisotropy Energy (MAE)
                </h3>
                <div
                    style="flex: 1; display: flex; align-items: center; justify-content: center; font-family:'JetBrains Mono'; color: var(--c); font-size: 1.35rem; text-shadow: 0 0 10px rgba(0,0,0,0.5);">
                    $$ \mathcal{H}_{SOC} = \xi \mathbf{L} \cdot \mathbf{S} $$
                </div>
            </div>
            <!-- 4. DMI (Span 3 cols - Centered row) -->
            <div class="card-bento"
                style="--c: var(--c-quantum); grid-column: span 3; display: flex; flex-direction: column;"
                onclick="openModal('param4')">
                <div class="module-number">04</div>
                <h3 style="font-size: 1.6rem; color: #fff; margin-top: 15px;">Dzyaloshinskii–Moriya Interaction (DMI)
                </h3>
                <div
                    style="flex: 1; display: flex; align-items: center; justify-content: center; font-family:'JetBrains Mono'; color: var(--c); font-size: 1.35rem; text-shadow: 0 0 10px rgba(0,0,0,0.5);">
                    $$ \mathcal{H}_{DMI} = \sum_{i,j} \mathbf{D}_{ij} \cdot (\mathbf{S}_i \times \mathbf{S}_j) $$
                </div>
            </div>
            <!-- 5. Tc (Span 3 cols - Centered row) -->
            <div class="card-bento"
                style="--c: var(--c-green); grid-column: span 3; display: flex; flex-direction: column;"
                onclick="openModal('param5')">
                <div class="module-number">05</div>
                <h3 style="font-size: 1.6rem; color: #fff; margin-top: 15px;">Temperaturas de Transición</h3>
                <div
                    style="flex: 1; display: flex; align-items: center; justify-content: center; font-family:'JetBrains Mono'; color: var(--c); font-size: 1.35rem; text-shadow: 0 0 10px rgba(0,0,0,0.5);">
                    $$ P \propto e^{-\frac{\Delta E}{k_B T}} $$
                </div>
                <div style="margin-top: auto; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.1);">
                    <div style="text-align: center; color: #fff; font-size: 1.1rem; margin-bottom: 5px;">
                        Cálculo de <span style="color: var(--c);">Néel ($T_N$)</span> / <span
                            style="color: var(--c);">Curie ($T_C$)</span>
                    </div>
                    <div style="text-align: center; font-size: 0.9rem; color: var(--text-muted);">
                        mediante <strong style="color: #fff; text-transform: uppercase; letter-spacing: 0.5px;">Monte
                            Carlo Simulated Annealing (MCSA)</strong>
                    </div>
                </div>
            </div>
        </div>
    </section>


