                <span
                    style="display: block; font-size: 1.6rem; margin-top: 15px; font-weight: 300; font-family: 'Playfair Display', serif; color: var(--text-muted); font-style: italic;">
                    <span style="color: var(--c-cyan); font-weight: 600; font-style: normal;">Abril 2017:</span>
                    Confirmación Experimental en Cristales de van der Waals
                </span>
            </h2>
            <div class="bento-grid"
                style="display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto; gap: 25px; max-width: 1400px; margin: 0 auto; height: 75vh;">

                <!-- Card 1: CrI3 (Left) -->
                <div class="card-bento"
                    style="--c: var(--c-ind); display: flex; flex-direction: column; background: linear-gradient(135deg, rgba(239, 68, 68, 0.05), rgba(15, 23, 42, 0.6)); border-color: rgba(239, 68, 68, 0.3);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <h3 style="font-size: 2rem; color: #fff; margin-bottom: 5px;">CrI<sub>3</sub></h3>
                            <div
                                style="color: var(--c-ind); font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;">
                                Universidad de Washington</div>
                        </div>
