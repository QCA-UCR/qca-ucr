        <div class="bento-grid"
            style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 30px; max-width: 1400px; margin: 0 auto; height: 75vh;">
            <!-- 1. Stoner (Span 2 cols) -->
            <div class="card-bento"
                style="--c: var(--c-ind); grid-column: span 2; display: flex; flex-direction: column;"
                onclick="openModal('param1')">
