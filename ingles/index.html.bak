    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>

    <script>
        // DATABASE OF MODULES: 5 PHYSICAL PARAMETERS
        const db = {
            param1: {
                c: "var(--c-ind)",
                t: "1. Criterio de Stoner",
                sub: "La Fórmula: $I \\cdot N(E_F) > 1$",
                img: `<img src="a.jpg" style="width: 100%; border-radius: 8px; box-shadow: 0 0 20px rgba(0,0,0,0.5);">`,
                txt: `<p>Para comenzar, evaluamos si el material tiene el potencial de ser magnético intrínsecamente. Usamos el <strong style="color: var(--mc);">Criterio de Stoner</strong> en un estado no magnético.</p>
                      <p>Aquí, buscamos una alta densidad de estados al nivel de Fermi ($N(E_F)$). Si la inestabilidad es suficiente (producto > 1), el sistema reducirá su energía rompiendo la simetría de espín, dando paso al ferromagnetismo itinerante.</p>`
            },
            param2: {
                c: "var(--c-gold)",
                t: "2. Intercambio ($J$ coupling)",
                sub: "La Fórmula: $\\mathcal{H} = -\\sum J_{ij} \\mathbf{S}_i \\cdot \\mathbf{S}_j$",
                img: `<i class="fa-solid fa-arrows-left-right-to-line" style="font-size: 8rem; color: var(--c-gold);"></i>`,
                txt: `<p>Una vez confirmado el momento magnético, necesitamos determinar el orden: <strong>¿Es Ferromagnético o Antiferromagnético?</strong></p>
                      <p>Mapeamos las energías totales obtenidas por DFT a un Hamiltoniano de Heisenberg clásico. Calculamos la diferencia de energía entre configuraciones de espín (FM vs AFM) para extraer los parámetros de intercambio $J$.</p>
                      <p>Un <strong style="color: var(--mc);">$J$ positivo</strong> nos indica ferromagnetismo, fundamental para las aplicaciones que buscamos.</p>`
            },
            param3: {
                c: "var(--c-blue)",
                t: "3. Magnetocrystalline Anisotropy Energy (MAE)",
                sub: "La Fórmula: $\\mathcal{H}_{SOC} = \\xi \\mathbf{L} \\cdot \\mathbf{S}$",
                img: `<i class="fa-solid fa-anchor" style="font-size: 8rem; color: var(--c-blue);"></i>`,
                txt: `<p>Esto es crucial en 2D. Sabemos por el teorema de Mermin-Wagner que el orden magnético en 2D es inestable frente a fluctuaciones térmicas a menos que exista anisotropía.</p>
                      <p>Aquí incluimos el <strong>Acoplamiento Espín-Órbita (SOC)</strong> en nuestros cálculos de DFT para cuantificar la MAE. Buscamos determinar el <strong style="color: var(--mc);">'Eje Fácil'</strong> de magnetización.</p>
                      <p>Para almacenamiento de alta densidad, generalmente buscamos una fuerte anisotropía perpendicular (fuera del plano).</p>`
            },
            param4: {
                c: "var(--c-quantum)",
                t: "4. Dzyaloshinskii-Moriya Interaction (DMI)",
                sub: "La Fórmula: $\\mathcal{H}_{DMI} = \\sum \\mathbf{D}_{ij} \\cdot (\\mathbf{S}_i \\times \\mathbf{S}_j)$",
                img: `<img src="skyrmion.png" style="width: 80%; border-radius: 50%;">`,
                txt: `<p>En sistemas donde se rompe la simetría de inversión (común en superficies o heteroestructuras), el SOC induce este término de intercambio antisimétrico.</p>
                      <p>Mientras que el intercambio $J$ intenta alinear los espines, el DMI intenta rotarlos. Esta competencia es la que estabiliza texturas topológicas como los <strong style="color: var(--mc);">Skyrmions</strong>, que son de alto interés para la espintrónica de nueva generación.</p>`
            },
            param5: {
                c: "var(--c-green)",
                t: "5. Temperaturas de Transición",
                sub: "La Fórmula: $P \\propto e^{-\\frac{\\Delta E}{k_B T}}$ (Monte Carlo)",
                img: `<i class="fa-solid fa-temperature-high" style="font-size: 8rem; color: var(--c-green);"></i>`,
                txt: `<p>Finalmente, conectamos la escala cuántica con la macroscópica. Tomamos los parámetros de intercambio $J$ y la anisotropía extraídos por DFT y los introducimos en simulaciones de Monte Carlo.</p>
                      <p>Esto nos permite estimar la <strong>Temperatura de Curie ($T_C$)</strong> o <strong>Néel ($T_N$)</strong> real del material, prediciendo si el magnetismo sobrevivirá a temperatura ambiente, que es el objetivo final para cualquier dispositivo práctico.</p>`
            },
            app1: {
                c: "var(--c-cyan)",
                t: "SOT-MRAM",
                sub: "Spin-Orbit Torque Magnetic RAM",
                img: `<i class="fa-solid fa-memory" style="font-size: 8rem; color: var(--c-cyan); filter:drop-shadow(0 0 20px rgba(34,211,238,0.5));"></i>`,
                txt: `<p>Las memorias <strong style="color:var(--mc);">SOT-MRAM</strong> utilizan corrientes de espín generadas por el efecto Hall de espín o el efecto Rashba-Edelstein para conmutar la magnetización de una capa libre, eliminando la necesidad de corrientes polarizadas a través de la barrera túnel.</p>
                      <p>Materiales 2D como <strong>Fe₃GaTe₂</strong> (ferromagnético a temperatura ambiente, $T_C \\sim 350$ K) se han integrado sobre capas pesadas de Pt para demostrar conmutación SOT con densidades de corriente crítica del orden de $J_c \\sim 10^5$ A/cm², significativamente menores que en dispositivos STT-MRAM convencionales.</p>
                      <p>La ventaja clave: la corriente de escritura fluye en el plano (no a través del óxido), lo que mejora la resistencia y la velocidad de conmutación (sub-ns). Esto posiciona a los materiales 2D como candidatos ideales para caches L1/L2 no volátiles.</p>`
            },
            app2: {
                c: "var(--c-blue)",
                t: "Válvulas de Espín (Spin Valves)",
                sub: "Magnetorresistencia Gigante & Túnel",
                img: `<i class="fa-solid fa-right-left" style="font-size: 8rem; color: var(--c-blue); filter:drop-shadow(0 0 20px rgba(56,189,248,0.5));"></i>`,
                txt: `<p>Las <strong style="color:var(--mc);">válvulas de espín</strong> son heterostructuras FM/espaciador/FM donde la resistencia depende de la orientación relativa de las magnetizaciones. Son la base de cabezas lectoras de disco duro y sensores.</p>
                      <p>En 2D, se han demostrado juntas túnel magnéticas van der Waals como <strong>Fe₃GeTe₂/hBN/Fe₃GeTe₂</strong> con TMR de ~160% a 4 K. La barrera de hBN de pocas capas actúa como espaciador túnel ideal con interfaces atómicamente nítidas, sin la interdifusión que limita a las juntas convencionales MgO.</p>
                      <p>La posibilidad de apilar capas 2D por transferencia mecánica abre el camino a ingeniería de interfaz sin precedentes en la espintrónica.</p>`
            },
            app3: {
                c: "var(--c-purple)",
                t: "Juntas Túnel Magnéticas (MTJs)",
                sub: "TMR récord en van der Waals",
                img: `<i class="fa-solid fa-layer-group" style="font-size: 8rem; color: var(--c-purple); filter:drop-shadow(0 0 20px rgba(167,139,250,0.5));"></i>`,
                txt: `<p>Las <strong style="color:var(--mc);">MTJs</strong> son el corazón funcional de la MRAM y de los sensores de campo magnético más sensibles. Consisten en dos electrodos FM separados por una barrera túnel ultrafina.</p>
                      <p>El sistema <strong>Grafeno/CrI₃/Grafeno</strong> ha mostrado resultados extraordinarios: la barrera de CrI₃ de pocas capas, siendo antiferromagnética entre capas, actúa como un filtro de espín perfecto. Se han predicho valores de TMR de hasta <strong>19,000%</strong> teóricamente, y experimentalmente se han alcanzado ~19,000% a bajas temperaturas con 4 capas de CrI₃.</p>
                      <p>El desafío principal es elevar la $T_C$ de CrI₃ (~45 K) para operación a temperatura ambiente, lo cual se investiga activamente mediante dopaje y strain engineering.</p>`
            },
            app4: {
                c: "var(--c-green)",
                t: "Spin-FETs",
                sub: "Transistores de Lógica Espintrónica",
                img: `<i class="fa-solid fa-microchip" style="font-size: 8rem; color: var(--c-green); filter:drop-shadow(0 0 20px rgba(74,222,128,0.5));"></i>`,
                txt: `<p>El <strong style="color:var(--mc);">Spin-FET</strong> (transistor de efecto de campo de espín) busca controlar el transporte de espín mediante un voltaje de compuerta, análogo a un MOSFET pero usando el grado de libertad de espín.</p>
                      <p>En sistemas 2D, se han demostrado prototipos basados en <strong>CrI₃ bicapa / Grafeno</strong>: al aplicar voltaje de compuerta se conmuta la alineación magnética entre capas de CrI₃ (AFM ↔ FM), modulando la resistencia del canal con un ratio On/Off de ~400%.</p>
                      <p>Esto demuestra el concepto de lógica magnética no volátil controlada eléctricamente, un paso fundamental hacia circuitos espintrónicos reconfigurables con disipación ultra-baja.</p>`
            },
            app5: {
                c: "var(--c-gold)",
                t: "Computación Neuromórfica",
                sub: "Sinapsis Artificiales Magnéticas",
                img: `<i class="fa-solid fa-brain" style="font-size: 8rem; color: var(--c-gold); filter:drop-shadow(0 0 20px rgba(250,204,21,0.5));"></i>`,
                txt: `<p>La <strong style="color:var(--mc);">computación neuromórfica</strong> busca emular la eficiencia del cerebro usando dispositivos analógicos. Los materiales magnéticos 2D ofrecen estados multinivel estables para implementar pesos sinápticos.</p>
                      <p>Dispositivos basados en <strong>Fe₃GeTe₂ oxidado</strong> han demostrado comportamiento sináptico con potenciación/depresión gradual, consumo energético de apenas ~2 fJ/pulso, y se han utilizado para clasificación de dígitos MNIST con una precisión de <strong>93.2%</strong>.</p>
                      <p>La combinación de no volatilidad, bajo consumo y escalabilidad de los materiales 2D los posiciona como una plataforma prometedora para hardware de inteligencia artificial de siguiente generación, especialmente en edge computing.</p>`
            },
            app6: {
                c: "var(--c-pink)",
                t: "Emisores THz",
                sub: "Espintrónica Ultrarrápida",
                img: `<i class="fa-solid fa-satellite-dish" style="font-size: 8rem; color: var(--c-pink); filter:drop-shadow(0 0 20px rgba(244,114,182,0.5));"></i>`,
                txt: `<p>Los <strong style="color:var(--mc);">emisores THz espintrónicos</strong> convierten pulsos de láser femtosegundo en radiación terahertz mediante corrientes de espín ultrarrápidas. Este rango de frecuencias (0.1–10 THz) es clave para comunicaciones 6G, imagen médica y espectroscopía.</p>
                      <p>Heterostructuras 2D como <strong>Cr₂Ge₂Te₆</strong> y <strong>Fe₃GeTe₂/Bi₂Te₃</strong> han demostrado emisión THz eficiente a temperatura ambiente, con eficiencias superiores al 1% y frecuencias centradas en ~0.9 THz.</p>
                      <p>La ventaja de las capas 2D es su grosor atómico: minimizan la reabsorción de la radiación THz generada, un problema común en las bicapas metálicas FM/NM convencionales, y permiten integración flexible en sustratos arbitrarios.</p>`
            },
            app7: {
                c: "var(--c-ind)",
                t: "Sensores Magnéticos",
                sub: "Detección Ultrasensible (NEMS)",
                img: `<i class="fa-solid fa-gauge-high" style="font-size: 8rem; color: var(--c-ind); filter:drop-shadow(0 0 20px rgba(239,68,68,0.5));"></i>`,
                txt: `<p>Los <strong style="color:var(--mc);">sensores magnéticos 2D</strong> explotan las propiedades magnéticas de monocapas para detección de campos con sensibilidad extrema, superando a los sensores Hall convencionales en resolución espacial.</p>
                      <p>Resonadores NEMS basados en <strong>VSe₂ monocapa</strong> han alcanzado sensibilidades de $1.6 \\times 10^7$ Hz/Oe, operando como filtros de paso bajo magnéticos. El cambio de frecuencia de resonancia ante campos magnéticos externos permite mediciones cuantitativas con resolución nanométrica.</p>
                      <p>Aplicaciones potenciales incluyen magnetometría de barrido para imagen de texturas magnéticas, biosensores magnéticos para detección de biomoléculas individuales, y navegación inercial en sistemas miniaturizados.</p>`
            },
            app8: {
                c: "var(--c-quantum)",
                t: "Memorias Skyrmiónicas",
                sub: "Almacenamiento Topológico de Alta Densidad",
                img: `<i class="fa-solid fa-hurricane" style="font-size: 8rem; color: var(--c-quantum); filter:drop-shadow(0 0 20px rgba(167,139,250,0.5));"></i>`,
                txt: `<p>Los <strong style="color:var(--mc);">skyrmions magnéticos</strong> son texturas de espín topológicamente protegidas — cuasipartículas nanométricas que pueden crearse, moverse y destruirse con corrientes mínimas. Esto los convierte en bits de información ideales para memorias de ultra-alta densidad.</p>
                      <p>En materiales 2D, se han observado skyrmions estables a temperatura ambiente (~330 K) en <strong>Fe₃₋ₓGaTe₂</strong>, con tamaños de ~100 nm y controlables por corriente eléctrica. La interacción DMI intrínseca en estos sistemas, combinada con la anisotropía perpendicular, estabiliza las texturas sin necesidad de campos magnéticos externos.</p>
                      <p>El concepto de "racetrack memory" skyrmiónica promete densidades de almacenamiento >100 Gbit/in² con consumo energético ordenes de magnitud menor que las memorias flash actuales.</p>`
            },
            mod1: {
                // Legacy support
                c: "#333", t: "Legacy", sub: "", img: "", txt: ""
            }
        };

        // MODAL LOGIC
        const modal = document.getElementById('modal');
        function openModal(id) {
            const data = db[id];
            if (!data) return;

            // Colors
            document.querySelector('.modal-content').style.setProperty('--mc', data.c);
            document.getElementById('m-bar').style.background = data.c;
            document.getElementById('m-subtitle').style.color = data.c;

            // Content
            document.getElementById('m-title').innerText = data.t;
            document.getElementById('m-subtitle').innerText = data.sub;
            document.getElementById('m-img-container').innerHTML = data.img;
            document.getElementById('m-script').innerHTML = data.txt;

            modal.classList.add('active');

            // Render Math
            setTimeout(() => {
                renderMathInElement(modal, {
                    delimiters: [{ left: '$$', right: '$$', display: true }, { left: '$', right: '$', display: false }],
                    throwOnError: false
                });
            }, 10);
        }

        function closeModal() {
            modal.classList.remove('active');
        }

        // SLIDESHOW LOGIC
        const slides = document.querySelectorAll('.slide');
        const indicator = document.getElementById('slide-indicator');
        const currentEl = document.getElementById('current-slide');
        const totalEl = document.getElementById('total-slides');
        let idx = 0;

        totalEl.textContent = slides.length;

        function updateSlide(newIdx) {
            if (newIdx < 0) newIdx = 0;
            if (newIdx >= slides.length) newIdx = slides.length - 1;
            idx = newIdx;

            slides.forEach((s, i) => {
                s.classList.remove('active');
                if (i === idx) s.classList.add('active');
            });

            currentEl.textContent = idx + 1;
            if (idx === 0) indicator.classList.add('hidden');
            else indicator.classList.remove('hidden');
        }

        window.goToSlideId = function (id) {
            const target = document.getElementById(id);
            if (target) {
                const index = Array.from(slides).indexOf(target);
                if (index !== -1) updateSlide(index);
            }
        };

        // FULLSCREEN LOGIC (F2 KEY)
        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    console.error(`Error attempting to enable fullscreen: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        document.addEventListener('keydown', e => {
            // F2 for Fullscreen
            if (e.key === 'F2') {
                e.preventDefault();
                toggleFullScreen();
            }

            // Escape to close modal
            if (e.key === 'Escape') closeModal();

            // Navigation (Arrows/Space) - Only if modal is NOT active
            if (!modal.classList.contains('active')) {
                if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') updateSlide(idx + 1);
                if (e.key === 'ArrowLeft') updateSlide(idx - 1);
            }
        });



        document.addEventListener('click', e => {
            if (e.target.closest('.glass-card') ||
                e.target.closest('.card-bento') ||
                e.target.closest('.modal-content') ||
                e.target.closest('th') || // Prevent navigation when clicking table headers
                e.target.tagName === 'BUTTON') return;

            if (modal.classList.contains('active')) return;

            if (e.clientX > window.innerWidth / 2) updateSlide(idx + 1);
            else updateSlide(idx - 1);
        });

        // Initialize Math
        document.addEventListener('DOMContentLoaded', () => {
            renderMathInElement(document.body, {
                delimiters: [{ left: '$$', right: '$$', display: true }, { left: '$', right: '$', display: false }]
            });
            updateSlide(0);
        });

        // SORT TABLE FUNCTION
        function sortTable(n, isNumber = false) {
            var table, rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
            table = document.getElementById("dataTable");
            switching = true;
            dir = "asc";
            while (switching) {
                switching = false;
                rows = table.rows;
                for (i = 1; i < (rows.length - 1); i++) {
                    shouldSwitch = false;
                    x = rows[i].getElementsByTagName("TD")[n];
                    y = rows[i + 1].getElementsByTagName("TD")[n];

                    let xVal = x.textContent || x.innerText;
                    let yVal = y.textContent || y.innerText;
                    // Clean up extra whitespace
                    xVal = xVal.trim(); yVal = yVal.trim();

                    if (isNumber) {
                        // Extract first number found
                        let xNum = parseFloat(xVal.match(/-?\d+(\.\d+)?/));
                        let yNum = parseFloat(yVal.match(/-?\d+(\.\d+)?/));
                        // Handle NaNs (e.g. "N/A" -> treat as lowest)
                        if (isNaN(xNum)) xNum = -9999;
                        if (isNaN(yNum)) yNum = -9999;
                        xVal = xNum; yVal = yNum;
                    } else {
                        xVal = xVal.toLowerCase();
                        yVal = yVal.toLowerCase();
                    }

                    if (dir == "asc") {
                        if (xVal > yVal) { shouldSwitch = true; break; }
                    } else if (dir == "desc") {
                        if (xVal < yVal) { shouldSwitch = true; break; }
                    }
                }
                if (shouldSwitch) {
                    rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                    switching = true;
                    switchcount++;
                } else {
                    if (switchcount == 0 && dir == "asc") {
                        dir = "desc";
                        switching = true;
                    }
                }
            }
        }

    </script>
</body>

</html>